# Mail CoastGuard — Environment Configuration Template (.env.example)
# Do not store production secrets or real API keys in this file.

AI_PROVIDER=
GEMINI_API_KEY=A
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=6144
OLLAMA_NUM_PREDICT=300
OLLAMA_KEEP_ALIVE=30m
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENT=1
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=
MAX_REQUEST_SIZE_BYTES=204800
RATE_LIMIT_PER_MINUTE=30
DEEP_ANALYSIS_RATE_LIMIT_PER_MINUTE=6
AI_MAX_CALLS_PER_HOUR=100
ADMIN_API_ENABLED=false
ADMIN_API_KEY_SHA256=
ADMIN_ALLOWED_IPS=127.0.0.1,::1
ADMIN_RATE_LIMIT_PER_MINUTE=20
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
