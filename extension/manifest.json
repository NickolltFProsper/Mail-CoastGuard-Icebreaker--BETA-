{
  "manifest_version": 3,
  "name": "Mail CoastGuard",
  "version": "1.0.0",
  "description": "Verificación de seguridad de correos institucionales: semáforo con los motivos de cada alerta.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
      "js": ["core.js", "sites.js", "icons_data.js", "panel_styles.js", "panel.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mail CoastGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
